{
  "name": "i-rlu",
  "displayName": "I-RLU — Interactive Report Layout Utility",
  "description": "Interactive, WYSIWYG designer for IBM i printer file DDS (RLU replacement), with live SCS/AFPDS page preview.",
  "version": "0.0.1",
  "publisher": "Manojkumar-Dharma",
  "repository": {
    "type": "git",
    "url": "https://github.com/Manojkumar-Dharma/I-RLU.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "i-rlu.designer",
        "displayName": "I-RLU Designer",
        "selector": [
          { "filenamePattern": "*.pf" },
          { "filenamePattern": "*.prtf" },
          { "filenamePattern": "*.rlu" },
          { "filenamePattern": "member:/**/*.pf" },
          { "filenamePattern": "member:/**/*.prtf" },
          { "filenamePattern": "streamfile:/**/*.pf" },
          { "filenamePattern": "streamfile:/**/*.prtf" }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "i-rlu.openDesigner",
        "title": "I-RLU: Open Report Designer"
      },
      {
        "command": "i-rlu.compilePrtf",
        "title": "I-RLU: Compile Printer File (CRTPRTF)"
      }
    ],
    "configuration": {
      "title": "I-RLU",
      "properties": {
        "i-rlu.unitOfMeasure": {
          "type": "string",
          "enum": ["inch", "cm"],
          "default": "inch",
          "description": "Unit of measure to assume when converting LINE/BOX/BARCODE physical measurements to the preview's character grid. There is no UOM keyword in DDS source — UOM is set on the CRTPRTF command that compiles this file, so I-RLU can't detect it from the source alone. Set this to match what your shop actually passes to CRTPRTF (its own default is *INCH); if you don't know, leave this as inch."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node src/buildWebviewTemplate.js",
    "watch": "tsc -p ./ -w",
    "pretest": "tsc -p ./ && node src/buildWebviewTemplate.js && node -e \"require('fs').mkdirSync('out/test/fixtures',{recursive:true});require('fs').cpSync('test/fixtures','out/test/fixtures',{recursive:true})\"",
    "test": "node --test out/test/prtfParser.test.js out/test/prtfFixtures.test.js out/test/prtfWriter.test.js out/test/prtfReferenceField.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
