      * I-RLU sample printer file - SCS device type (no AFPDS keywords)

                                            PAGSIZE(66 132) DEVTYPE(*SCS)      +
                                            CPI(10) LPI(6)
                R HEADER                    SKIPB(1)
                                        1  1'MONTHLY SALES REPORT'
                                        1 60'PAGE' SPACEB(0)
                                        1 65PAGNBR
                                        3  1'REGION'
                                        3 20'SALES AMT'
                R DETAIL                    OVERFLOW(60)
                  REGNAME       15A  O  1  1
                  SALESAMT       9S 2O  1 20EDTCDE(J)
                R FOOTER                    SKIPB(2)
                                        1  1'--- END OF REPORT ---'
